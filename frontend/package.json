{
  "name": "control-tickets-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend del Sistema de Control de Tickets (Vue 3 + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "build:apk": "vue-tsc -b && vite build --mode apk && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@stomp/stompjs": "^7.3.0",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.7.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "three": "^0.186.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
