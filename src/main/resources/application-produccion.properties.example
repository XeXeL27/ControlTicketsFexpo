# Plantilla del perfil de servidor (SIN secretos: este archivo SI va a git).
# Copiar como application-produccion.properties y completar los valores reales.
# Ese archivo con claves NO se sube (ver .gitignore).
spring.datasource.url=jdbc:postgresql://IP_SERVIDOR:5432/NOMBRE_BD
spring.datasource.username=
spring.datasource.password=
spring.jpa.hibernate.ddl-auto=validate
app.jwt.secret=
app.jwt.expiration-ms=86400000
# Orígenes permitidos (separados por coma). https://localhost es el APK
# (Capacitor sirve la app desde ahí); sin él, el APK recibe 403 por CORS.
# En el servidor real, sumar también el dominio web si sirve el front por jar.
app.cors.allowed-origins=http://localhost:9099,https://localhost
app.admin.username=
app.admin.password=
server.port=9099
sigse.url=
sigse.api-key=
app.feria.validar-dia=true
